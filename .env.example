# Switch agent adapter
# Server address as seen from where the adapter runs (on the VM, not Console's tunnel port).
SWITCH_SERVER_URL=http://127.0.0.1:8000
# Registration key from the Gateway, API Keys. Used once to register `premise`. Never commit it.
SWITCH_REGISTRATION_KEY=
# Agent id, API key and cursors are stored here. It is gitignored.
SWITCH_STATE_DIR=.runtime/switch

# Premise. docker-compose.switch.yml publishes FalkorDB on 6380 and the app on 8100.
GITHUB_TOKEN=
SANDBOX_REPO=Razeefshaik/premise-switch
SANDBOX_DIR=sandbox/kestrel-platform
SANDBOX_CLONE_DIR=.runtime/kestrel
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
# Public hosting: enable this to force read-only routes and disable poller/models.
PUBLIC_DEMO=false
GRAPH_NAME=premise_switch
PUBLIC_BASE_URL=http://localhost:8100
POLL_SECONDS=15
POLL_ENABLED=false
AUTO_FIX_PR=false
STEWARD_ENABLED=false
# Answers in Switch rooms are deterministic. Keep this set to none.
ANTHROPIC_API_KEY=
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
CODEX_BINARY=
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=180
